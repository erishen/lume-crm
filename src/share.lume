// src/share.lume — SSR 客户分享页组件(库侧)
//
// 纯函数组件:只依赖 el()/html() 内建,不碰服务器状态(同 examples/demo/ui.lume
// 的组件纪律)。入口 `import "src/share.lume" as crmshare;` 后即可复用。
//
// 安全:客户姓名/公司/邮箱/电话/商机标题/跟进 note 全部经 html() 的 {N} 标量槽
// 输出——槽内标量自动转义,客户字段里藏 <script> 也不会被执行(存储型 XSS 不可行,
// 有实测断言)。页面自包含 CSS,零外部依赖,GET-only,天然适配只读演示模式。

// 商机行:标题 / 阶段徽章 / 金额(全部标量槽转义)
func deal_row(d) {
  return html("<tr>"
    + "<td class='deal-title'>{0}</td>"
    + "<td><span class='stage'>{1}</span></td>"
    + "<td class='num'>¥{2}</td>"
    + "</tr>", str(d.title), str(d.stage), str(d.amount));
}

// 跟进项:类型徽章 / note / 时间
func act_item(a) {
  return html("<li>"
    + "<span class='kind'>{0}</span>"
    + "<span class='note'>{1}</span>"
    + "<time>{2}</time>"
    + "</li>", str(a.kind), str(a.note), str(a.at_fmt));
}

// 分享页壳:全档数据一次渲染。c 是 crmdb.customer_by_id(id) 的返回(稀疏)。
export func share_page(c) {
  let deal_rows = map((d) => deal_row(d), get(c, "deals", []));
  let acts = map((a) => act_item(a), get(c, "activities", []));
  let deal_empty = [];
  if (len(deal_rows) == 0) {
    deal_empty = [html("<tr><td colspan='3' class='empty'>暂无商机</td></tr>")];
  }
  let act_empty = [];
  if (len(acts) == 0) {
    act_empty = [html("<li class='empty'>暂无跟进记录</li>")];
  }
  return html("<!doctype html>"
    + "<html lang='zh-CN'><head>"
    + "<meta charset='utf-8'>"
    + "<meta name='viewport' content='width=device-width, initial-scale=1'>"
    + "<title>{0} · Lume CRM</title>"
    + "<style>"
    + ":root{color-scheme:light}"
    + "*{box-sizing:border-box;margin:0;padding:0}"
    + "body{font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;"
    + "background:#f4f6fb;color:#1f2937;line-height:1.6;padding:24px}"
    + ".wrap{max-width:640px;margin:0 auto}"
    + ".hero{background:linear-gradient(135deg,#4f6ef7,#7c5cf0);color:#fff;"
    + "border-radius:16px;padding:32px;margin-bottom:16px}"
    + ".hero h1{font-size:28px;margin-bottom:4px}"
    + ".hero .co{opacity:.85;font-size:15px}"
    + ".contact{display:flex;gap:16px;flex-wrap:wrap;margin-top:16px;font-size:14px}"
    + ".contact span{background:rgba(255,255,255,.16);padding:4px 12px;border-radius:99px}"
    + "section{background:#fff;border-radius:16px;padding:24px;margin-bottom:16px;"
    + "border:1px solid #e5e9f2}"
    + "h2{font-size:15px;color:#6b7280;text-transform:uppercase;"
    + "letter-spacing:.05em;margin-bottom:12px}"
    + "table{width:100%;border-collapse:collapse;font-size:14px}"
    + "td{padding:8px 4px;border-bottom:1px solid #eef1f7}"
    + ".num{text-align:right;font-variant-numeric:tabular-nums}"
    + ".stage{display:inline-block;background:#eef2ff;color:#4f46e5;"
    + "padding:2px 10px;border-radius:99px;font-size:12px}"
    + "ul{list-style:none}li{display:flex;gap:10px;align-items:baseline;"
    + "padding:8px 0;border-bottom:1px solid #eef1f7;font-size:14px}"
    + ".kind{flex:none;background:#ecfdf5;color:#059669;padding:2px 10px;"
    + "border-radius:99px;font-size:12px}"
    + ".note{flex:1}"
    + "time{flex:none;color:#9ca3af;font-size:12px}"
    + ".empty{color:#9ca3af;text-align:center;padding:16px 0}"
    + "footer{text-align:center;color:#9ca3af;font-size:13px;padding:8px 0 24px}"
    + "footer a{color:#4f6ef7;text-decoration:none}"
    + "</style></head><body><div class='wrap'>"
    + "<div class='hero'>"
    + "<h1>{0}</h1>"
    + "<div class='co'>{1}</div>"
    + "<div class='contact'>"
    + "<span>✉ {2}</span><span>☎ {3}</span>"
    + "</div></div>"
    + "<section><h2>商机 Pipeline</h2>"
    + "<table>{4}{5}</table></section>"
    + "<section><h2>跟进记录</h2><ul>{6}{7}</ul></section>"
    + "<footer>由 <a href='https://github.com/erishen/lume'>lume</a> 单二进制"
    + " C11 后端渲染 · 数据于服务端 SSR,本页零 JavaScript</footer>"
    + "</div></body></html>",
    str(c.name), str(get(c, "company", "")),
    str(get(c, "email", "")), str(get(c, "phone", "")),
    deal_rows, deal_empty, acts, act_empty);
}
