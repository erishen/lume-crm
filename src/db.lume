// crm/src/db.lume — CRM 领域层:SQLite 数据层 + 读写助手 + 聊天工具
//
// 数据落 .data/crm.db(SQLite,3 张表)。读路径走 sql_query(物理只读,
// 免锁);写路径 flock 串行 + sql_write(护栏写),新 id 用 MAX(id)+1
// (last_insert_rowid 跨连接不可用)。
//
// 内建特性用法(见 lume/docs/STYLE.md):
//   - sql_* 失败置 sticky VM error → 一律 try(() => sql_*(...)) 捕获,
//     固定 { ok, err } 键直接成员访问
//   - 回调单表达式用表达式体箭头:map((c) => {...}) 多语句才开块
//   - 值一律 ? 占位符绑定(参数不进 SQL 文本,杜绝注入)
//   - LIKE ? 参数化模糊搜索,通配符在 DSL 侧拼接(仍是绑定值,不进 SQL)
//   - 业务字典常量(阶段/终态/默认)是 SQL 条件的单一事实源:stats 与
//     留痕逻辑都从 closed_stages 生成,不在各处硬编码阶段名

let crm_db = ".data/crm.db";
let crm_lock_path = ".data/.crm.lock";   // 不能与 crm_lock() 同名

// 公网只读演示开关:LUME_CRM_READONLY=1 时只注册查询类聊天工具(搜索/详情),
// 增删改工具不进注册表 —— 提示注入再狠也没有可调用的破坏面。HTTP 写路由在
// crm.lume 用同一开关 403。默认不设 = 完全可写(本地/开发)。
let crm_readonly = env("LUME_CRM_READONLY") == "1";

// ------------------------------------------------ 分享页防枚举(share token)
// token = substr(sha256(salt + ":" + id [+ ":" + version]), 0, 32)。
// 链接元数据(版本/过期/撤销/最后访问)落 share_links;DSL 没有 CSPRNG,
// 但 salt 保密时无法为任意 id 伪造 → /share/customer?id=N 直接枚举失效。
// version=0 保留老链接兼容;重新生成时 version+1,旧 token 立即失效。
// salt 取值优先级:
//   1. LUME_CRM_SHARE_SALT(>=16 字符,建议 `openssl rand -hex 32`)。
//   2. 回退 LUME_CRM_VISIT_PIN 派生(兼容已上线、只配了 PIN 的演示)。
//   3. 都没有 → share_token() 返回 "" → 路由一律 404(fail closed)。
// 注意:变量名不能含 SECRET/TOKEN/KEY,否则被 lume 的 env() 按未设置屏蔽。
let share_salt = env("LUME_CRM_SHARE_SALT");
if (share_salt == null or len(share_salt) < 16) {
  let share_pin = env("LUME_CRM_VISIT_PIN");
  if (share_pin != null and len(share_pin) >= 16) {
    share_salt = "visit-pin:" + share_pin;
  } else {
    share_salt = "";
  }
}

export func share_token(cid) {
  if (share_salt == "") {
    return "";
  }
  return substr(sha256(share_salt + ":" + str(cid)), 0, 32);
}

// 分享链接 TTL:默认 30 天;0 = 不过期(不推荐)。env 只接受纯十进制,
// 非法值回退默认,避免 typo 静默变成"永不过期"。
let share_ttl_days = 30;
let share_ttl_raw = env("LUME_CRM_SHARE_TTL_DAYS");
if (share_ttl_raw != null and share_ttl_raw != "") {
  let n = int(share_ttl_raw);
  if (n >= 0 and str(n) == share_ttl_raw) {
    share_ttl_days = n;
  }
}
let share_ttl_sec = share_ttl_days * 86400;

// 访客数据保留期:默认 90 天;0 = 不自动清理(不推荐)。
let visit_retention_days = 90;
let visit_retention_raw = env("LUME_CRM_VISIT_RETENTION_DAYS");
if (visit_retention_raw != null and visit_retention_raw != "") {
  let n = int(visit_retention_raw);
  if (n >= 0 and str(n) == visit_retention_raw) {
    visit_retention_days = n;
  }
}
let visit_last_cleanup = 0;

// 分享链接落库:token、过期时间、撤销标记、最后访问。token 仍是派生
// (salt + customer + version),version 递增即可让旧链接失效;DSL 没有
// CSPRNG,但 salt 保密时伪造/枚举不可行。version=0 保留老链接兼容。
export func create_share_link(cid) {
  if (share_salt == "") {
    return null;
  }
  let maxv = q("SELECT COALESCE(MAX(version), -1) AS v FROM share_links WHERE customer = ?", [cid]);
  let version = int(get(maxv, 0, {}), "v", -1) + 1;
  let token = "";
  if (version == 0) {
    token = share_token(cid);
  } else {
    token = substr(sha256(share_salt + ":" + str(cid) + ":" + str(version)), 0, 32);
  }
  if (token == "") {
    return null;
  }
  let ts = int(now());
  let expires = 0;
  if (share_ttl_sec > 0) {
    expires = ts + share_ttl_sec;
  }
  let r = try(() => sql_write(crm_db,
    "INSERT INTO share_links (customer, version, token, created, expires, revoked, last_access) VALUES (?, ?, ?, ?, ?, 0, 0)",
    [cid, version, token, ts, expires]));
  if (r.err != null) {
    print("分享链接写入失败: " + r.err);
    return null;
  }
  return { customer: cid, version: version, token: token, created: ts, expires: expires, revoked: 0, last_access: 0 };
}

// 当前有效链接:有 active 返回;该客户从未建过链接则自动建 version=0
// (兼容老链接);已有 history 但全部过期/撤销 → 返回 null,不自动复活。
export func active_share_link(cid) {
  let ts = int(now());
  let rs = q("SELECT id, customer, version, token, created, expires, revoked, last_access"
    + " FROM share_links WHERE customer = ? AND revoked = 0"
    + " AND (expires = 0 OR expires > ?) ORDER BY version DESC, id DESC LIMIT 1", [cid, ts]);
  if (len(rs) > 0) {
    return get(rs, 0, {});
  }
  let any = q("SELECT COUNT(*) AS n FROM share_links WHERE customer = ?", [cid]);
  if (int(get(any, 0, {}), "n", 0) == 0) {
    return create_share_link(cid);
  }
  return null;
}

// 校验 token;命中则更新 last_access(失败不影响页面,只打日志)。
// 老链接兼容:该客户还没有 share_links 行时,允许原 sha256(salt:id) token
// 一次性落库;一旦撤销/过期,旧 token 不会再次复活。
export func share_link_by_token(cid, token) {
  let ts = int(now());
  let rs = q("SELECT id, customer, version, token, created, expires, revoked, last_access"
    + " FROM share_links WHERE customer = ? AND token = ? AND revoked = 0"
    + " AND (expires = 0 OR expires > ?) LIMIT 1", [cid, token, ts]);
  if (len(rs) > 0) {
    let link = get(rs, 0, {});
    let r = try(() => sql_write(crm_db, "UPDATE share_links SET last_access = ? WHERE id = ?", [ts, link.id]));
    if (r.err != null) {
      print("分享访问记录失败: " + r.err);
    }
    return link;
  }
  if (share_salt != "" and token == share_token(cid)) {
    let any = q("SELECT COUNT(*) AS n FROM share_links WHERE customer = ?", [cid]);
    if (int(get(any, 0, {}), "n", 0) == 0) {
      return create_share_link(cid);
    }
  }
  return null;
}

// 撤销该客户当前所有有效链接;再次分享需显式 create(version+1)。
export func revoke_share_links(cid) {
  let r = try(() => sql_write(crm_db,
    "UPDATE share_links SET revoked = 1 WHERE customer = ? AND revoked = 0", [cid]));
  if (r.err != null) {
    print("分享链接撤销失败: " + r.err);
    return false;
  }
  return true;
}

// 历史 visit referrer 清洗:老版本存了完整 URL,可能含第三方 token/搜索词。
func scrub_visit_referrers() {
  for (t in ["visits_full", "visits"]) {
    let rs = q("SELECT id, referrer FROM " + t
      + " WHERE referrer LIKE '%?%' OR referrer LIKE '%#%'", null);
    for (row in rs) {
      let ref = str(row.referrer);
      let clean = split(ref, "?")[0];
      clean = split(clean, "#")[0];
      if (clean != ref) {
        let r = try(() => sql_write(crm_db,
          "UPDATE " + t + " SET referrer = ? WHERE id = ?", [clean, row.id]));
        if (r.err != null) {
          print("referrer 清洗失败(" + t + "): " + r.err);
        }
      }
    }
  }
}

// 访客保留期清理:启动时跑一次,运行中每 24h 最多一次。
func cleanup_visits() {
  if (visit_retention_days <= 0) {
    return;
  }
  let cutoff = int(now()) - visit_retention_days * 86400;
  let r = try(() => sql_write(crm_db, "DELETE FROM visits_full WHERE created < ?", [cutoff]));
  if (r.err != null) {
    print("访客清理失败: " + r.err);
  }
  let r2 = try(() => sql_write(crm_db, "DELETE FROM visits WHERE created < ?", [cutoff]));
  if (r2.err != null) {
    print("旧访客清理失败: " + r2.err);
  }
  // bot_ips 也按保留期清理；留 1 天宽限，避免刚过期就被重新标记的竞态。
  let rb = try(() => sql_write(crm_db, "DELETE FROM bot_ips WHERE until < ?", [int(now()) - 86400]));
  if (rb.err != null) {
    print("爬虫 IP 清理失败: " + rb.err);
  }
  visit_last_cleanup = int(now());
}

// ------------------------------------------------ 业务字典(单一事实源)
// 阶段白名单:服务端强制(add/update_deal 校验),前端选项经 /api/meta 下发,
// 不靠前端自觉。新增阶段只改这里一处。
let deal_stages = ["初步接洽", "方案", "谈判", "成交", "丢单"];
// 已决(终态)阶段:推进到这里的商机不再计入开放管道;update_deal 自动留痕、
// stats_payload 的开放管道统计共用这一份,不各自硬编码。
let closed_stages = ["成交", "丢单"];
// 默认阶段(add_deal 的 stage 空串兜底) = 第一个开放阶段
let default_stage = "初步接洽";
// 跟进类型建议集(前端选项 + 工具描述用;服务端不硬校验 kind,允许自定义)
let activity_kinds = ["电话", "会议", "邮件", "拜访", "记录"];

func in_list(xs, v) {
  let found = false;
  for (x in xs) {
    if (x == v) {
      found = true;
    }
  }
  return found;
}

// 商机阶段合法性:空串(=不改/默认)放行,非空必须命中白名单
func stage_valid(s) {
  let sv = str(s);
  if (sv == "") {
    return true;
  }
  return in_list(deal_stages, sv);
}

// 把业务字典常量渲染成 SQL 的 'a', 'b' 字面量串(阶段名是本仓自己的常量,
// 不是用户输入,拼进 SQL 文本安全;参数绑定只面向调用方数据)。
// 新增/调整阶段只改上面的 let,stats 与留痕逻辑自动跟随。
func in_clause(xs) {
  let s = "";
  for (x in xs) {
    if (s == "") {
      s = "'" + str(x) + "'";
    } else {
      s = s + ", '" + str(x) + "'";
    }
  }
  return s;
}

// 白名单连接成 "a / b / c",错误消息里告诉调用方合法值
func stages_str() {
  let s = "";
  for (x in deal_stages) {
    if (s == "") {
      s = str(x);
    } else {
      s = s + " / " + str(x);
    }
  }
  return s;
}

// ---------------------------------------------------------------- 建库/建表
mkdir(".data");

// 首跑初始化:库文件不存在时造 0 字节(sql_write 的 open 不带 CREATE 标志,
// 打不开缺失文件;write_file 只在确实缺失时用——原子写会覆盖,不能每次跑)。
func ensure_db() {
  let exists = false;
  for (f in files(".data")) {
    if (f == "crm.db") {
      exists = true;
    }
  }
  if (not exists) {
    let w = try(() => write_file(crm_db, ""));
    if (w.err != null) {
      print("警告: 无法创建 " + crm_db + ": " + w.err);
      return;
    }
  }
  let ddl = [
    "CREATE TABLE IF NOT EXISTS customers (id INTEGER PRIMARY KEY AUTOINCREMENT, name TEXT NOT NULL, company TEXT, email TEXT, phone TEXT, created INTEGER)",
    "CREATE TABLE IF NOT EXISTS deals (id INTEGER PRIMARY KEY AUTOINCREMENT, customer INTEGER, title TEXT, stage TEXT, amount REAL, updated INTEGER)",
    "CREATE TABLE IF NOT EXISTS activities (id INTEGER PRIMARY KEY AUTOINCREMENT, customer INTEGER, kind TEXT, note TEXT, at INTEGER)",
    // visits 旧表保留(历史数据备份,结构不变);visits_full 是带 ip 的正式表。
    // sql_write 禁 ALTER/DROP,故新列只能落新表 + 一次性拷贝迁移(幂等)。
    "CREATE TABLE IF NOT EXISTS visits (id INTEGER PRIMARY KEY AUTOINCREMENT, path TEXT, referrer TEXT, ua TEXT, visitor TEXT, created INTEGER)",
    "CREATE TABLE IF NOT EXISTS visits_full (id INTEGER PRIMARY KEY AUTOINCREMENT, path TEXT, referrer TEXT, ua TEXT, visitor TEXT, ip TEXT, created INTEGER)",
    "CREATE TABLE IF NOT EXISTS bot_ips (ip TEXT PRIMARY KEY, reason TEXT, until INTEGER, created INTEGER)",
    // 分享链接表:token 落库才能做 TTL/撤销/最后访问;老库 CREATE IF NOT EXISTS 自动补。
    "CREATE TABLE IF NOT EXISTS share_links (id INTEGER PRIMARY KEY AUTOINCREMENT, customer INTEGER NOT NULL, version INTEGER NOT NULL, token TEXT NOT NULL UNIQUE, created INTEGER NOT NULL, expires INTEGER NOT NULL DEFAULT 0, revoked INTEGER NOT NULL DEFAULT 0, last_access INTEGER NOT NULL DEFAULT 0)",
  ];
  for (s in ddl) {
    let r = try(() => sql_write(crm_db, s));
    if (r.err != null) {
      print("警告: 建表失败: " + r.err);
      return;
    }
  }
  // 旧库迁移:visits_full 为空时把 visits 旧数据拷入(ip 补 NULL),之后不再拷贝。
  let mig = try(() => sql_write(crm_db,
    "INSERT INTO visits_full (path, referrer, ua, visitor, ip, created) SELECT path, referrer, ua, visitor, NULL, created FROM visits WHERE (SELECT COUNT(*) FROM visits_full) = 0",
    null));
  if (mig.err != null) {
    print("提示: visits 迁移跳过: " + mig.err);
  }
  // 隐私清理:历史 referrer 剥 query/hash;按保留期删访客记录。
  scrub_visit_referrers();
  cleanup_visits();
  // 种子:customers 表为空才灌(重复启动幂等)
  let nc = q("SELECT COUNT(*) AS n FROM customers", null);
  if (int(get(nc, 0, {}), "n", 0) > 0) {
    return;
  }
  let t = now();
  // 列表不支持 list[i] 下标(解析器遇 [ 报错),嵌套 [sql, params] 取不出;
  // 用 map 字面量(sql/params 键,成员访问 e.sql / e.params)承载。
  // 演示数据刻意「一眼假」:占位名(张三/李四) + example.com(IANA 保留给文档的
  // 域名,不可能是真邮箱) + 连号演示手机号,杜绝与任何真实人物/企业撞车。
  let seed = [
    { sql: "INSERT INTO customers (id, name, company, email, phone, created) VALUES (?, ?, ?, ?, ?, ?)", params: [1, "张三", "示例科技有限公司", "zhangsan@example.com", "13000000001", t] },
    { sql: "INSERT INTO customers (id, name, company, email, phone, created) VALUES (?, ?, ?, ?, ?, ?)", params: [2, "李四", "演示数据有限公司", "lisi@example.com", "13000000002", t] },
    { sql: "INSERT INTO deals (id, customer, title, stage, amount, updated) VALUES (?, ?, ?, ?, ?, ?)", params: [1, 1, "示例 · 私有部署", "谈判", 120000.0, t] },
    { sql: "INSERT INTO deals (id, customer, title, stage, amount, updated) VALUES (?, ?, ?, ?, ?, ?)", params: [2, 2, "演示 · 年度席位", "初步接洽", 45000.0, t] },
    { sql: "INSERT INTO activities (id, customer, kind, note, at) VALUES (?, ?, ?, ?, ?)", params: [1, 1, "会议", "演示跟进记录:需求评审(示例数据)", t - 86400] },
    { sql: "INSERT INTO activities (id, customer, kind, note, at) VALUES (?, ?, ?, ?, ?)", params: [2, 2, "电话", "演示跟进记录:首次触达(示例数据)", t - 172800] },
  ];
  for (s in seed) {
    let r = try(() => sql_write(crm_db, s.sql, s.params));
    if (r.err != null) {
      print("警告: 种子写入失败: " + r.err);
      return;
    }
  }
  print("crm: SQLite 初始化完成(" + crm_db + ", 种子数据已注入)");
}

// ---------------------------------------------------------------- 查询助手
// 只读:sql_query 物理只读 + 参数绑定。失败(sticky error)兜底空列表,
// 路由降级为"空数据"而不是 500。
func q(sql, params) {
  let r = try(() => sql_query(crm_db, sql, params));
  if (r.ok == null) {
    return [];
  }
  return r.ok;
}

// 云厂商第一节号清单。真实浏览器也可能从云主机/VPN 访问，所以只有再叠加
// “云 IP 无来源/同 IP 多 UA” 才判为机器人，避免单凭 ASN 误杀。
func cloud_ip_sql() {
  return "ip LIKE '3.%' OR ip LIKE '13.%' OR ip LIKE '18.%' OR ip LIKE '20.%' OR ip LIKE '32.%' OR ip LIKE '34.%' OR ip LIKE '35.%' OR ip LIKE '40.%' OR ip LIKE '43.%' OR ip LIKE '44.%' OR ip LIKE '45.%' OR ip LIKE '50.%' OR ip LIKE '52.%' OR ip LIKE '54.%' OR ip LIKE '57.%' OR ip LIKE '64.%' OR ip LIKE '66.%' OR ip LIKE '69.%' OR ip LIKE '95.%' OR ip LIKE '98.%' OR ip LIKE '104.%' OR ip LIKE '108.%' OR ip LIKE '129.%' OR ip LIKE '135.%' OR ip LIKE '149.%' OR ip LIKE '158.%' OR ip LIKE '159.%' OR ip LIKE '165.%' OR ip LIKE '167.%' OR ip LIKE '173.%' OR ip LIKE '174.%' OR ip LIKE '185.%' OR ip LIKE '188.%' OR ip LIKE '195.%' OR ip LIKE '206.%' OR ip LIKE '213.%' OR ip LIKE '139.155.%'";
}

func cloud_ip(ip) {
  let parts = split(ip, ".");
  if (len(parts) < 2) { return false; }
  let a = str(get(parts, 0, ""));
  if (a == "3" or a == "13" or a == "18" or a == "20" or a == "32" or a == "34" or a == "35") { return true; }
  if (a == "40" or a == "43" or a == "44" or a == "45" or a == "50" or a == "52" or a == "54" or a == "57") { return true; }
  if (a == "64" or a == "66" or a == "69" or a == "95" or a == "98" or a == "104" or a == "108") { return true; }
  if (a == "129" or a == "135" or a == "149" or a == "158" or a == "159" or a == "165" or a == "167") { return true; }
  if (a == "173" or a == "174" or a == "185" or a == "188" or a == "195" or a == "206" or a == "213") { return true; }
  if (a == "139" and str(get(parts, 1, "")) == "155") { return true; }
  return false;
}

func ua_has(ua, needle) {
  return replace(ua, needle, "") != ua;
}

func is_browser_ua(ua) {
  if (not ua_has(ua, "Mozilla/")) { return false; }
  return ua_has(ua, "Chrome/") or ua_has(ua, "Firefox/") or ua_has(ua, "Safari/");
}

func recent_multi_ua(ip, ua, since) {
  let r = q("SELECT COUNT(DISTINCT ua) AS n FROM visits_full WHERE ip = ? AND ua IS NOT NULL AND ua <> '' AND ua <> ? AND created >= ?",
    [ip, ua, since]);
  return int(get(r, 0, {}), "n", 0) > 0;
}

func mark_bot_ip(ip, reason) {
  let t = int(now());
  let r = try(() => sql_write(crm_db,
    "INSERT INTO bot_ips (ip, reason, until, created) VALUES (?, ?, ?, ?) ON CONFLICT(ip) DO UPDATE SET reason = excluded.reason, until = MAX(bot_ips.until, excluded.until)",
    [ip, reason, t + 604800, t]));
  if (r.err != null) {
    print("visit 记录爬虫 IP 失败: " + r.err);
  }
}

// 返回非空 reason = 该次访问按爬虫处理；只影响汇总，不删原始记录。
func detect_bot(path, referrer, ua, ip, wd) {
  if (wd == "true") { return "webdriver"; }
  if (ip == "" or ip == null) { return ""; }
  if (not cloud_ip(ip)) { return ""; }
  if (not is_browser_ua(ua)) { return ""; }
  if (recent_multi_ua(ip, ua, int(now()) - 600)) { return "cloud_multi_ua"; }
  // 云主机无来源访问：正常读者通常带站内/外链来源；爬虫直接抓站内任意路径。
  if (referrer == "") { return "cloud_no_referrer"; }
  return "";
}

// 启动时把近期“云 IP + 同 IP 多 UA”的历史记录一次性标进 bot_ips。
// 只补缺不续期: 已有记录 DO NOTHING, 保留首次 created/until; 运行中再次识别
// 才由 mark_bot_ip 推 until。
func seed_bot_ips() {
  let t = int(now());
  let since = t - 30 * 86400;
  let sql = "INSERT INTO bot_ips (ip, reason, until, created) SELECT ip, 'cloud_multi_ua', ?, ? FROM visits_full WHERE ip IS NOT NULL AND ip <> '' AND (" + cloud_ip_sql() + ") AND created >= ? GROUP BY ip HAVING COUNT(DISTINCT ua) > 1 ON CONFLICT(ip) DO NOTHING";
  let r = try(() => sql_write(crm_db, sql, [t + 2592000, t, since]));
  if (r.err != null) {
    print("visit 初始化爬虫 IP 失败: " + r.err);
  }
  let sql2 = "INSERT INTO bot_ips (ip, reason, until, created) SELECT ip, 'cloud_no_referrer', ?, ? FROM visits_full WHERE ip IS NOT NULL AND ip <> '' AND (" + cloud_ip_sql() + ") AND (referrer IS NULL OR referrer = '') AND created >= ? GROUP BY ip ON CONFLICT(ip) DO NOTHING";
  let r2 = try(() => sql_write(crm_db, sql2, [t + 2592000, t, since]));
  if (r2.err != null) {
    print("visit 初始化无来源爬虫失败: " + r2.err);
  }
}

// 时间戳显示:SQL 侧 strftime 只认 UTC,本地时区在 DSL 侧用内建 strftime
// (localtime)补,与旧 JSON 版行为一致。
func fmt_ts(ts) {
  return strftime("%Y-%m-%d", int(ts));
}

// ---------------------------------------------------------------- 读路径
// 客户总表(含关联计数/管道金额):一条 SELECT 出全,免应用层聚合循环。
export func customer_list(query, sort) {
  let sql = "SELECT c.id, c.name, c.company, c.email, c.phone, c.created,"
    + " (SELECT COUNT(*) FROM deals WHERE customer = c.id) AS deal_count,"
    + " (SELECT COUNT(*) FROM activities WHERE customer = c.id) AS activity_count,"
    + " (SELECT COALESCE(SUM(amount), 0.0) FROM deals WHERE customer = c.id) AS pipeline"
    + " FROM customers c";
  // 空列表当"无参数"而不是 null: q() 直接把 params 交给 sql_query,
  // sqlite 侧对空数组与 null 的处理一致(都表示无绑定值), 但**类型**上
  // 空列表与 [pat,pat,pat] 是同构的 —— 而 null 与列表不是, 后者赋值会
  // 触发 assignment type mismatch。(同样的问题在 lume-lan 的 peer/agent.lume
  // 也踩过: {..} 字面量与 null 都有固定的窄类型。)
  let params = [];
  if (query != "") {
    sql = sql + " WHERE c.name LIKE ? OR c.company LIKE ? OR c.email LIKE ?";
    let pat = "%" + query + "%";   // 通配符拼接后仍是绑定值,不进 SQL 文本
    params = [pat, pat, pat];
  }
  // 排序:默认 id 升序;sort="pipeline" 时管道金额降序(并列回退 id)
  let order = "ORDER BY c.id";
  if (str(sort) == "pipeline") {
    order = "ORDER BY pipeline DESC, c.id";
  }
  let rs = q(sql + " " + order, params);
  return map((c) => {
    put(c, "created_fmt", fmt_ts(c.created));
    return c;
  }, rs);
}

// 单个客户全档:基础信息 + 名下商机 + 跟进记录(跟进倒序,最新在前;
// 展示用的本地时间字段在 DSL 侧补:created_fmt / updated_fmt / at_fmt)
export func customer_by_id(cid) {
  let rs = q("SELECT id, name, company, email, phone, created FROM customers WHERE id = ?", [cid]);
  if (len(rs) == 0) {
    return null;
  }
  let c = get(rs, 0, {});
  put(c, "created_fmt", fmt_ts(c.created));
  put(c, "deals", map((dl) => {
    put(dl, "updated_fmt", fmt_ts(dl.updated));
    return dl;
  }, q("SELECT id, customer, title, stage, amount, updated FROM deals WHERE customer = ? ORDER BY id", [cid])));
  put(c, "activities", map((a) => {
    put(a, "at_fmt", strftime("%Y-%m-%d %H:%M", int(a.at)));
    return a;
  }, q("SELECT id, customer, kind, note, at FROM activities WHERE customer = ? ORDER BY at DESC, id DESC", [cid])));
  return c;
}

// 仪表盘统计:按阶段聚合 + 开放管道 + 客户总表,全在 SQL 里算完
export func stats_payload() {
  let custs = customer_list("", "");
  let by_stage = {};
  for (s in q("SELECT stage, COUNT(*) AS n, COALESCE(SUM(amount), 0.0) AS amt FROM deals GROUP BY stage", null)) {
    put(by_stage, s.stage, int(s.n));
    put(by_stage, s.stage + ".amt", float(s.amt));
  }
  // 开放管道 = 非终态商机;"哪些算终态"从 closed_stages 字典生成,
  // 与 update_deal 的自动留痕共用同一份阶段定义。
  let open = q("SELECT COALESCE(SUM(amount), 0.0) AS t FROM deals WHERE stage NOT IN (" + in_clause(closed_stages) + ")", null);
  let won = q("SELECT COUNT(*) AS n, COALESCE(SUM(amount), 0.0) AS t FROM deals WHERE stage = '成交'", null);
  let lost = q("SELECT COUNT(*) AS n FROM deals WHERE stage = '丢单'", null);
  let won_n = int(get(won, 0, {}), "n", 0);
  let won_amt = float(get(won, 0, {}), "t", 0.0);
  let lost_n = int(get(lost, 0, {}), "n", 0);
  // 成交率:只在有已决商机(成交或丢单)时算,分母为 0 给 0.0
  let decided = won_n + lost_n;
  let win_rate = 0.0;
  if (decided > 0) {
    win_rate = float(won_n) / float(decided);
  }
  return {
    customer_count: len(custs),
    deal_count: int(get(q("SELECT COUNT(*) AS n FROM deals", null), 0, {}), "n", 0),
    open_pipeline: float(get(open, 0, {}), "t", 0.0),
    won_deals: won_n,
    won_amount: won_amt,
    lost_deals: lost_n,
    win_rate: win_rate,
    by_stage: by_stage,
    customers: custs,
  };
}

// ---------------------------------------------------------------- 访客统计
// visits_full 表存 path/referrer(已剥 query)/ua/visitor/ip/时间。访客去重靠
// 前端 localStorage 生成的 visitor id;IP 只认 nginx 覆写的 X-Real-IP
// (回退 remote_addr),仅 owner 通过 PIN 门禁的 /api/visits 可见,线上 UI 不展示。
// 公开埋点限流：同一 IP 在 window_seconds 内达到 limit 条就拒绝，避免脚本刷库。
// 只读查询，不额外建表；窗口内已有的访问行同时用于汇总和限流。
export func too_many_visits(ip, limit, window_seconds) {
  if (ip == null or ip == "") { return false; }
  let since = int(now()) - window_seconds;
  let r = q("SELECT COUNT(*) AS n FROM visits_full WHERE ip = ? AND created >= ?", [ip, since]);
  return int(get(r, 0, {}), "n", 0) >= limit;
}

export func record_visit(path, referrer, ua, visitor, ip, wd) {
  // 长时间运行的进程也要按保留期清理;最多每 24h 一次。
  if (visit_last_cleanup > 0 and int(now()) - visit_last_cleanup >= 86400) {
    cleanup_visits();
  }
  let reason = detect_bot(path, referrer, ua, ip, wd);
  if (reason != "") {
    mark_bot_ip(ip, reason);
  }
  let r = try(() => sql_write(crm_db,
    "INSERT INTO visits_full (path, referrer, ua, visitor, ip, created) VALUES (?, ?, ?, ?, ?, ?)",
    [path, referrer, ua, visitor, ip, int(now())]));
  if (r.err != null) { print("visit 写入失败: " + r.err); }
  return r.err == null;
}

export func visits_summary() {
  // 本机/内网 IP 不计入统计:排除服务端本机回环(127.x/::1)、docker 网关
  // (172.17.x)与内网段(10.x、192.168.x、172.16-31.x、169.254.x),同时滤掉
  // 历史无 IP 记录(NULL/空)。只统计公网真实访客。
  let priv = "ip IS NULL OR ip = '' OR ip LIKE '127.%' OR ip = '::1' OR ip LIKE '10.%' OR ip LIKE '192.168.%' OR ip LIKE '169.254.%' OR ip LIKE '172.16.%' OR ip LIKE '172.17.%' OR ip LIKE '172.18.%' OR ip LIKE '172.19.%' OR ip LIKE '172.2%.%' OR ip LIKE '172.30.%' OR ip LIKE '172.31.%'";
  // 忽略列表(env LUME_CRM_IGNORE_IPS,逗号分隔公网 IP):与 priv 一起排除。
  // 值与 priv 同为静态拼接,无用户输入;清洗空格/单引号后等值匹配。
  let ignore = env("LUME_CRM_IGNORE_IPS");
  if (ignore != null and ignore != "") {
    ignore = replace(replace(ignore, " ", ""), "'", "");
    priv = priv + " OR ip IN ('" + replace(ignore, ",", "','") + "')";
  }
  // 爬虫 UA 不计入统计(常见搜索引擎/AI 爬虫;SQLite LIKE 对 ASCII 不区分
  // 大小写,Googlebot/googlebot 等变体都能命中),同时排除无 UA 记录(与无
  // IP 同理,参考价值低)。与 priv/ignore 一起排除,历史已入库的爬虫记录
  // 也被过滤,统计只剩真人访问。
  let bots = "ua IS NULL OR ua = '' OR ua LIKE '%googlebot%' OR ua LIKE '%googleother%' OR ua LIKE '%bingbot%' OR ua LIKE '%baiduspider%' OR ua LIKE '%yandexbot%' OR ua LIKE '%duckduckbot%' OR ua LIKE '%petalbot%' OR ua LIKE '%bytespider%' OR ua LIKE '%semrushbot%' OR ua LIKE '%ahrefsbot%' OR ua LIKE '%mj12bot%' OR ua LIKE '%sogou%' OR ua LIKE '%360spider%' OR ua LIKE '%ia_archiver%' OR ua LIKE '%archive.org_bot%' OR ua LIKE '%gptbot%' OR ua LIKE '%chatgpt-user%' OR ua LIKE '%ccbot%' OR ua LIKE '%applebot%' OR ua LIKE '%claudebot%' OR ua LIKE '%facebookexternalhit%' OR ua LIKE '%twitterbot%' OR ua LIKE '%linkedinbot%' OR ua LIKE '%pinterest%' OR ua LIKE '%telegrambot%' OR ua LIKE '%whatsapp%'";
  priv = priv + " OR " + bots;
  priv = priv + " OR ip IN (SELECT ip FROM bot_ips WHERE until > " + str(int(now())) + ")";
  let total = int(get(q("SELECT COUNT(*) AS n FROM visits_full WHERE NOT (" + priv + ")", null), 0, {}), "n", 0);
  let today = int(get(q("SELECT COUNT(*) AS n FROM visits_full WHERE date(created,'unixepoch','localtime') = date('now','localtime') AND NOT (" + priv + ")", null), 0, {}), "n", 0);
  let uv = int(get(q("SELECT COUNT(DISTINCT visitor) AS n FROM visits_full WHERE NOT (" + priv + ")", null), 0, {}), "n", 0);
  let start = int(now()) - 13 * 86400;
  let days = [];
  for (s in q("SELECT date(created,'unixepoch','localtime') AS d, COUNT(*) AS pv, COUNT(DISTINCT visitor) AS uv FROM visits_full WHERE created >= ? AND NOT (" + priv + ") GROUP BY d ORDER BY d DESC LIMIT 14", [start])) {
    push(days, { d: s.d, pv: int(s.pv), uv: int(s.uv) });
  }
  // 最近访客(owner 查看"谁来过、从哪来":时间/IP/来源/页面/UA)
  let recent = [];
  for (s in q("SELECT datetime(created,'unixepoch','localtime') AS t, ip, referrer, path, ua FROM visits_full WHERE NOT (" + priv + ") ORDER BY id DESC LIMIT 20", null)) {
    push(recent, { t: s.t, ip: s.ip, referrer: s.referrer, path: s.path, ua: s.ua });
  }
  return { total: total, today: today, uv: uv, days: days, recent: recent };
}

// ---------------------------------------------------------------- 写路径
// 纪律:全程 flock(SQLite C 侧未设 busy_timeout,worker 并发写靠应用层
// 串行);sql_write 失败经 try 捕获,逐路径解锁后返回带 status 的 err。
// 新 id = MAX(id)+1(持锁期间安全);flock 锁文件父目录要自己 mkdir。

export func crm_lock() {
  mkdir(".data");
  return lock_file(crm_lock_path, 3000);
}

export func crm_unlock() {
  unlock_file();
}

func next_id(table) {
  let rs = q("SELECT MAX(id) AS id FROM " + table, null);
  let v = get(get(rs, 0, {}), "id", null);
  if (v == null) {
    return 1;
  }
  return int(v) + 1;
}

// 客户存在性检查(护栏:挂单/记跟进前先验)
func customer_exists(cid) {
  return int(get(q("SELECT COUNT(*) AS n FROM customers WHERE id = ?", [cid]), 0, {}), "n", 0) > 0;
}

export func add_customer(name, company, email, phone) {
  if (str(name) == "") {
    return { err: "name 必填", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  let cid = next_id("customers");
  let r = try(() => sql_write(crm_db,
    "INSERT INTO customers (id, name, company, email, phone, created) VALUES (?, ?, ?, ?, ?, ?)",
    [cid, name, company, email, phone, now()]));
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 写入失败: " + r.err, status: 500 };
  }
  return { ok: true, id: cid, name: name };
}

// 改客户资料:空串 = 不改该字段(与 update_deal 同款语义),name 非空才覆盖。
export func update_customer(cid, name, company, email, phone) {
  if (int(cid) <= 0) {
    return { err: "customer_id 必填", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  let rs = q("SELECT name, company, email, phone FROM customers WHERE id = ?", [int(cid)]);
  if (len(rs) == 0) {
    crm_unlock();
    return { err: "客户 " + str(cid) + " 不存在", status: 404 };
  }
  let c = get(rs, 0, {});
  let name_v = str(name);
  if (name_v != "") {
    put(c, "name", name_v);
  }
  let company_v = str(company);
  if (company_v != "") {
    put(c, "company", company_v);
  }
  let email_v = str(email);
  if (email_v != "") {
    put(c, "email", email_v);
  }
  let phone_v = str(phone);
  if (phone_v != "") {
    put(c, "phone", phone_v);
  }
  let r = try(() => sql_write(crm_db,
    "UPDATE customers SET name = ?, company = ?, email = ?, phone = ? WHERE id = ?",
    [c.name, c.company, c.email, c.phone, int(cid)]));
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 写入失败: " + r.err, status: 500 };
  }
  return { ok: true, id: int(cid), name: c.name };
}

// 删除客户并级联清掉其名下商机/跟进(子表先删,主表后删)。
export func delete_customer(cid) {
  if (int(cid) <= 0) {
    return { err: "customer_id 必填", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  if (not customer_exists(int(cid))) {
    crm_unlock();
    return { err: "客户 " + str(cid) + " 不存在", status: 404 };
  }
  let rd = try(() => sql_write(crm_db, "DELETE FROM deals WHERE customer = ?", [int(cid)]));
  if (rd.err != null) {
    crm_unlock();
    return { err: "删除商机失败: " + rd.err, status: 500 };
  }
  let ra = try(() => sql_write(crm_db, "DELETE FROM activities WHERE customer = ?", [int(cid)]));
  if (ra.err != null) {
    crm_unlock();
    return { err: "删除跟进失败: " + ra.err, status: 500 };
  }
  // 客户删除后分享链接必须一并清掉,避免 stale token/审计行。
  let rs = try(() => sql_write(crm_db, "DELETE FROM share_links WHERE customer = ?", [int(cid)]));
  if (rs.err != null) {
    crm_unlock();
    return { err: "删除分享链接失败: " + rs.err, status: 500 };
  }
  let rc = try(() => sql_write(crm_db, "DELETE FROM customers WHERE id = ?", [int(cid)]));
  crm_unlock();
  if (rc.err != null) {
    return { err: "删除客户失败: " + rc.err, status: 500 };
  }
  return {
    ok: true, id: int(cid),
    deals_deleted: int(rd, "ok", 0),
    activities_deleted: int(ra, "ok", 0),
    share_links_deleted: int(rs, "ok", 0),
  };
}

export func add_deal(cid, title, stage, amount) {
  if (str(title) == "" or int(cid) <= 0) {
    return { err: "customer_id 与 title 必填", status: 400 };
  }
  // 阶段白名单(服务端强制,不靠前端自觉):非空且不在 deal_stages 里 → 400
  if (not stage_valid(stage)) {
    return { err: "阶段必须是: " + stages_str(), status: 400 };
  }
  if (float(amount) < 0) {
    return { err: "金额不能为负", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  if (not customer_exists(int(cid))) {
    crm_unlock();
    return { err: "客户 " + str(cid) + " 不存在", status: 404 };
  }
  let stage_v = str(stage);
  if (stage_v == "") {
    stage_v = default_stage;
  }
  let did = next_id("deals");
  let r = try(() => sql_write(crm_db,
    "INSERT INTO deals (id, customer, title, stage, amount, updated) VALUES (?, ?, ?, ?, ?, ?)",
    [did, int(cid), title, stage_v, amount, now()]));
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 写入失败: " + r.err, status: 500 };
  }
  return { ok: true, deal_id: did, customer_id: int(cid), stage: stage_v, amount: amount };
}

export func update_deal(did, stage, title, amount) {
  if (int(did) <= 0) {
    return { err: "deal_id 必填", status: 400 };
  }
  // 阶段白名单:传了非空 stage 才校验,空串=不改(与 add_deal 同一 helper)
  if (not stage_valid(stage)) {
    return { err: "阶段必须是: " + stages_str(), status: 400 };
  }
  if (float(amount) < 0) {
    return { err: "金额不能为负", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  let rs = q("SELECT customer, title, stage, amount, updated FROM deals WHERE id = ?", [int(did)]);
  if (len(rs) == 0) {
    crm_unlock();
    return { err: "商机 " + str(did) + " 不存在", status: 404 };
  }
  let de = get(rs, 0, {});
  let old_stage = str(de.stage);
  // "空串/零值 = 不改该字段"语义在 DSL 侧做:读出旧值,新值非零才覆盖
  let stage_v = str(stage);
  if (stage_v != "") {
    put(de, "stage", stage_v);
  }
  let title_v = str(title);
  if (title_v != "") {
    put(de, "title", title_v);
  }
  let amount_v = float(amount);
  if (amount_v > 0) {
    put(de, "amount", amount_v);
  }
  put(de, "updated", now());
  let r = try(() => sql_write(crm_db,
    "UPDATE deals SET customer = ?, title = ?, stage = ?, amount = ?, updated = ? WHERE id = ?",
    [de.customer, de.title, de.stage, de.amount, de.updated, int(did)]));
  // 业务留痕:主写成功后,推进到终态(closed_stages 字典)且阶段确实变化 →
  // 同锁内自动记一条系统跟进。不能复用 add_activity(它内部会重拿锁,替换当前这把)。
  let closed = false;
  if (r.err == null and old_stage != str(de.stage) and in_list(closed_stages, str(de.stage))) {
    closed = true;
    let aid = next_id("activities");
    let sys_note = "商机《" + str(de.title) + "》推进：" + old_stage + " → " + de.stage;
    try(() => sql_write(crm_db,
      "INSERT INTO activities (id, customer, kind, note, at) VALUES (?, ?, ?, ?, ?)",
      [aid, int(de.customer), "系统", sys_note, now()]));
  }
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 写入失败: " + r.err, status: 500 };
  }
  return { ok: true, deal_id: int(did), stage: de.stage, amount: de.amount, closed: closed };
}

export func add_activity(cid, kind, note) {
  if (str(note) == "" or int(cid) <= 0) {
    return { err: "customer_id 与 note 必填", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  if (not customer_exists(int(cid))) {
    crm_unlock();
    return { err: "客户 " + str(cid) + " 不存在", status: 404 };
  }
  let kind_v = str(kind);
  if (kind_v == "") {
    kind_v = "记录";
  }
  let aid = next_id("activities");
  let r = try(() => sql_write(crm_db,
    "INSERT INTO activities (id, customer, kind, note, at) VALUES (?, ?, ?, ?, ?)",
    [aid, int(cid), kind_v, note, now()]));
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 写入失败: " + r.err, status: 500 };
  }
  return { ok: true, activity_id: aid, customer_id: int(cid), kind: kind_v };
}

// 删一条商机(误挂/重复录入的清理;成交/丢单也可删,删完不进管道统计)
export func delete_deal(did) {
  if (int(did) <= 0) {
    return { err: "deal_id 必填", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  let rs = q("SELECT customer FROM deals WHERE id = ?", [int(did)]);
  if (len(rs) == 0) {
    crm_unlock();
    return { err: "商机 " + str(did) + " 不存在", status: 404 };
  }
  let r = try(() => sql_write(crm_db, "DELETE FROM deals WHERE id = ?", [int(did)]));
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 删除失败: " + r.err, status: 500 };
  }
  return { ok: true, deal_id: int(did) };
}

// 删一条跟进(误记/作废留痕记录)
export func delete_activity(aid) {
  if (int(aid) <= 0) {
    return { err: "activity_id 必填", status: 400 };
  }
  if (not crm_lock()) {
    return { err: "写锁超时,请重试", status: 409 };
  }
  let rs = q("SELECT id FROM activities WHERE id = ?", [int(aid)]);
  if (len(rs) == 0) {
    crm_unlock();
    return { err: "跟进 " + str(aid) + " 不存在", status: 404 };
  }
  let r = try(() => sql_write(crm_db, "DELETE FROM activities WHERE id = ?", [int(aid)]));
  crm_unlock();
  if (r.err != null) {
    return { err: "SQLite 删除失败: " + r.err, status: 500 };
  }
  return { ok: true, activity_id: int(aid) };
}

// 业务字典下发:阶段白名单 + 终态标记 + 跟进类型建议集,前端选项单一事实源。
export func meta_payload() {
  return {
    deal_stages: deal_stages,
    closed_stages: closed_stages,
    default_stage: default_stage,
    activity_kinds: activity_kinds,
  };
}

// ---------------------------------------------------------------- 聊天工具
// typed 参数自动生成 JSON schema,缺键按类型零值(int→0, string→"")。
// 工具 = 助手薄壳:校验/锁/写全在助手里,工具只做参数适配。

tool "crm_search_customers", "在 CRM 中搜索客户。query 空串 = 返回全部;否则按 姓名/公司/邮箱 模糊匹配(子串)。返回客户列表(含 pipeline 金额与商机数)。", { query: string }, (arg) => {
  let all = customer_list(arg.query, "");
  return { count: len(all), customers: all };
};

tool "crm_get_customer", "取单个客户全档(基础信息 + 名下所有商机与跟进记录)。customer_id 必须存在。", { customer_id: int }, (arg) => {
  let c = customer_by_id(arg.customer_id);
  if (c == null) {
    return { err: "客户 " + str(arg.customer_id) + " 不存在" };
  }
  return c;
};

// 只读模式下跳过注册:下面 8 个增删改工具整体不进注册表,
// Agent 的工具清单里压根不存在,注入也无法调用。
if (not crm_readonly) {
  tool "crm_add_customer", "新建客户。name 必填;company/email/phone 可空(空串占位)。", { name: string, company: string, email: string, phone: string }, (arg) => {
    return add_customer(arg.name, arg.company, arg.email, arg.phone);
  };

  tool "crm_update_customer", "改客户资料(公司/邮箱/电话/姓名)。customer_id 必须已存在;空串字段不改。", { customer_id: int, name: string, company: string, email: string, phone: string }, (arg) => {
    return update_customer(arg.customer_id, arg.name, arg.company, arg.email, arg.phone);
  };

  tool "crm_delete_customer", "删除客户并级联清掉其名下全部商机与跟进记录。customer_id 必须已存在;操作不可撤销。", { customer_id: int }, (arg) => {
    return delete_customer(arg.customer_id);
  };

  tool "crm_add_deal", "给某客户挂一条商机。customer_id 必须已存在;stage 建议用 初步接洽/方案/谈判/成交/丢单,空串默认 初步接洽。", { customer_id: int, title: string, stage: string, amount: float }, (arg) => {
    return add_deal(arg.customer_id, arg.title, arg.stage, arg.amount);
  };

  tool "crm_update_deal", "改一条商机的阶段/金额/标题(推进管道用,如 谈判→成交)。deal_id 必须已存在;空串/零值字段不改。", { deal_id: int, stage: string, amount: float, title: string }, (arg) => {
    return update_deal(arg.deal_id, arg.stage, arg.title, arg.amount);
  };

  tool "crm_add_activity", "给客户记一条跟进(电话/会议/邮件/拜访…),note 必填;kind 空串默认 记录。", { customer_id: int, kind: string, note: string }, (arg) => {
    return add_activity(arg.customer_id, arg.kind, arg.note);
  };

  tool "crm_delete_deal", "删一条商机(误挂/重复录入)。deal_id 必须已存在;删后不再计入管道统计。", { deal_id: int }, (arg) => {
    return delete_deal(arg.deal_id);
  };

  tool "crm_delete_activity", "删一条跟进记录(误记/作废)。activity_id 必须已存在。", { activity_id: int }, (arg) => {
    return delete_activity(arg.activity_id);
  };
}


// 模块 import 即执行:main 进程初始化库(建表+种子),fork 的 worker 继承。
// 幂等——表/种子都在,重复启动不重复灌。放在文件末尾:此时 q()/sql_* 助手
// 已全部定义,ensure_db 内部调用才满足 Lume "被调函数先声明" 的顺序要求。
ensure_db();
seed_bot_ips();

// 行业 × 商机阶段 聚合
//
// 为什么需要它: 「今天该联系哪个行业」如果只看客户数, 永远是 1 —— 没有区分度。
// 真正有信息量的是**这些客户处在什么阶段**: 一个在"谈判"的客户, 和一个
// 只有"初步接洽"的客户, 值得投入的注意力完全不同。
//
// 边界(与 industry_payload 一致): 只输出计数与金额, **不含客户名、
// 不含联系人、不含任何能定位到具体人的字段**。销售拿到的信息是
// "某行业有几个客户在谈判", 而不是"哪些客户在谈判"。
// 行业归类由调用方传入 classify(company)->industry, 避免 db 层重复一份规则。
export func industry_stage_payload(classify) {
  let cs = customer_list("", "");
  // 先把 customer id → 行业 映射出来(行业归类仍用同一套关键词规则,
  // 两处若各写一份, 早晚会不一致)
  let ind_of = {};
  let unclassified = 0;
  let i = 0;
  while (i < len(cs)) {
    let c = get(cs, i, {});
    let ind = str(classify(str(get(c, "company", ""))));
    if (len(ind) == 0) {
      unclassified = unclassified + 1;
    } else {
      ind_of = put(ind_of, str(get(c, "id", 0)), ind);
    }
    i = i + 1;
  }

  // 每个商机落到 (行业, 阶段) 格子里。没有商机的客户不进这个统计 ——
  // 它们的"阶段"是空, 算进去会让"初步接洽"的数字虚高。
  let deals = q("SELECT customer, stage, amount FROM deals", null);
  let grid = {};
  let j = 0;
  while (j < len(deals)) {
    let d = get(deals, j, {});
    let ind = str(get(ind_of, str(get(d, "customer", 0)), ""));
    let stage = str(get(d, "stage", ""));
    if (len(ind) > 0 and len(stage) > 0) {
      // 键用 "行业|阶段", 值 {count, amount}
      let key = ind + "|" + stage;
      let cnt = int(get(get(grid, key, {}), "count", 0)) + 1;
      let amt = float(get(get(grid, key, {}), "amount", 0.0)) + float(get(d, "amount", 0.0));
      grid = put(grid, key, { count: cnt, amount: amt });
    }
    j = j + 1;
  }

  // 摊平成 [{industry, stage, count, amount}], 按行业聚拢
  let out = [];
  let ks = keys(grid);
  let k = 0;
  while (k < len(ks)) {
    let key = str(get(ks, k, ""));
    let parts = split(key, "|");
    let ind = str(get(parts, 0, ""));
    let stage = str(get(parts, 1, ""));
    let cell = get(grid, key, {});
    push(out, {
      industry: ind,
      stage: stage,
      count: int(get(cell, "count", 0)),
      amount: float(get(cell, "amount", 0.0)),
    });
    k = k + 1;
  }
  // 再算每个行业的"最高阶段": 谈判 > 初步接洽。
  // 这个字段是协商的关键 —— 客户侧用"该行业有没有进入谈判的客户"
  // 作为优先依据, 而不是客户数。
  let best = {};
  let m = 0;
  while (m < len(out)) {
    let row = get(out, m, {});
    let ind = str(get(row, "industry", ""));
    let st = str(get(row, "stage", ""));
    let rank = stage_rank(st);
    if (rank > int(get(best, ind, -1))) {
      best = put(best, ind, rank);
    }
    m = m + 1;
  }
  let summary = [];
  let bs = keys(best);
  let n = 0;
  while (n < len(bs)) {
    let ind = str(get(bs, n, ""));
    push(summary, { industry: ind, stage_rank: int(get(best, ind, 0)),
                    best_stage: stage_name(int(get(best, ind, 0))) });
    n = n + 1;
  }

  return {
    industries: summary,
    stages: out,
    unclassified_customers: unclassified,
    // 说明这份数据的用途, 避免被当成"客户清单"
    note: "仅按行业与阶段聚合; 不含客户名/联系人/联系方式",
  };
}

// 阶段优先级。数字越大越靠后(越接近成交), 协商时用这个排序。
// 未列出的阶段给 0 —— 不猜。
func stage_rank(stage: string): int {
  if (stage == "成交") { return 4; }
  if (stage == "谈判") { return 3; }
  if (stage == "方案") { return 2; }
  if (stage == "初步接洽") { return 1; }
  return 0;
}

func stage_name(rank: int): string {
  if (rank >= 4) { return "成交"; }
  if (rank == 3) { return "谈判"; }
  if (rank == 2) { return "方案"; }
  if (rank == 1) { return "初步接洽"; }
  return "无";
}
