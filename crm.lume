// crm.lume — CRM 入口:server{} + HTTP 路由 + 领域助手/工具 import
//
// 启动: lume crm.lume  → http://127.0.0.1:8089   (lume = release, 默认 ~/.local/bin/lume)
//   /            仪表盘(React SPA)   /customers  客户列表
//   /customers/N 客户详情            /chat       Agent 聊天(SSE)
//   GET  /api/customers?q=          客户列表(可选 ?q= 模糊筛选)
//   GET  /api/customer?id=<n>      客户全档
//   GET  /api/stats                 仪表盘统计
//   GET  /api/visits                访客统计(总 PV/今日/独立访客/近 14 天)
//   POST /api/visit                 访客埋点(前端加载时上报,不受只读限制)
//   POST /api/customers             新建客户
//   POST /api/deals                 新建商机
//   POST /api/deals/update          改商机阶段/金额/标题(空字段=不改)
//   POST /api/activities           新增跟进
//   POST /api/share/create         生成/轮换客户分享链接(旧链接立即失效)
//   POST /api/share/revoke         撤销客户分享链接
//   GET  /share/customer?id=<n>&token=<t>  客户分享页(SSR 零 JS;token 防枚举)
//   GET  /discovery                框架内省:tools/skills/mcps 目录(JSON)
//   POST /react/api/chat           Agent SSE(框架原生,聊天页用)
//
// 数据层:SQLite(.data/crm.db)。路由只管 body 解析 + 调助手;
// 校验/锁/SQL 全在 src/db.lume 的助手里,与 agent 工具同源。
//
// 部署/安全:bind 默认 127.0.0.1(本地安全);容器化传 LUME_BIND=0.0.0.0 才能
// 被端口映射命中。htpasswd 走 env("HTPASSWD_FILE"):本地留空=无认证;公网
// 部署务必注入(见 docker-entrypoint.sh + compose),否则 /api/* 与聊天工具
// 裸暴露,任何人都可读写 .data/crm.db。
// 注意:lume v0.8.1 的 Basic Auth 是全局的(自定义路由与 /share/ 同样拦),
// 公网若要公开分享页,认证只放 nginx 并给 /share/ 例外;不要同时开容器内
// HTPASSWD_FILE/LUME_AUTH_PASSWORD,否则分享链接会 401。

// bind 可经 env 覆盖(容器传 LUME_BIND=0.0.0.0);本地默认仍绑 127.0.0.1。
// htpasswd 走 env:本地留空=无认证,公网注入 HTPASSWD_FILE 即开 Basic Auth。
let crm_bind = env("LUME_BIND");
if (crm_bind == null) { crm_bind = "127.0.0.1"; }
server {
  port = 8089;
  workers = 2;
  bind = crm_bind;
  docroot = "./www";
  spa = true;        // SPA history 路由:GET + Accept:text/html + 静态 404
                     // → 回退 docroot/index.html;API 404 / fetch 保持原样
  htpasswd = env("HTPASSWD_FILE");
};

// 只读演示开关:LUME_CRM_READONLY=1 时全部写路由 403(公网演示无鉴权也玩不坏;
// 本地/开发不设该变量 = 完全可写)。Agent 工具面在 src/db.lume 同步收敛。
let crm_readonly = env("LUME_CRM_READONLY") == "1";

// 分享页默认只给客户看"可对外"字段;内部跟进备注默认隐藏。
// LUME_CRM_SHARE_INCLUDE_INTERNAL=1 才恢复旧行为(内部演示/自用)。
let crm_share_internal = env("LUME_CRM_SHARE_INCLUDE_INTERNAL") == "1";

func write_gate() {
  if (crm_readonly) {
    return { status: 403, body: { err: "演示模式为只读(LUME_CRM_READONLY=1),写操作已禁用" } };
  }
  return null;
}

// 访客统计只给 owner 看:配置 LUME_CRM_VISIT_PIN 后,查询须通过门禁才放行,
// 否则 403——统计(含 IP 列表)不暴露给公网访客。
// 本地可写开发不设该 env = 免 PIN(自用便利);只读演示(LUME_CRM_READONLY=1)
// 不设 = 403(fail closed),防止忘配 PIN 时访客统计裸奔。
// 注意:变量名刻意避开 TOKEN/KEY/SECRET 等敏感词——lume 的 env() 会把
// 含这些词的变量名按"未设置"处理(防 DSL 侧泄露密钥),会静默关闭门禁。
//
// 门禁三条通道(任一精确匹配即放行,精确比较、fail closed):
//   1. `X-CRM-Pin` 专用头(推荐,反代场景):避开 nginx Basic Auth 对
//      Authorization 头的占用——一个请求只能带一个 Authorization,客户端
//      无法同时发 Basic(过反代)和 Bearer(给应用)。nginx 默认转发自定义头,
//      应用侧大小写不敏感匹配即可。
//   2. `Authorization: Bearer <pin>` 或裸 `<pin>`(直连 / 关掉 Basic 时)。
//   3. query `?pin=`(过渡 fallback,旧客户端/旧二进制;已做日志打码)。
let visit_pin = env("LUME_CRM_VISIT_PIN");

// 大小写不敏感取请求头:HTTP 头名不区分大小写,而 req.headers 保留客户端
// 原始大小写(X-CRM-Pin / x-crm-pin 都可能)。仅核心内建 keys/lower/get。
// 旧版 bridge 没有 headers 字段时 get() 返回 null → ""(自动降级到其它通道)。
func header_ci(req, want) {
  let hs = get(req, "headers", null);
  if (hs == null) {
    return "";
  }
  for (k in keys(hs)) {
    if (lower(k) == want) {
      return get(hs, k, "");
    }
  }
  return "";
}

// 取 PIN,返回 "" 表示这些通道都没提供(由 visit_gate 决定是否看 query)。
// 顺序:X-CRM-Pin → Authorization(非 Basic)→ 交给 query fallback。
func auth_pin(req) {
  let hdr = header_ci(req, "x-crm-pin");
  if (hdr != null and hdr != "") {
    return hdr;
  }
  let a = get(req, "authorization", "");
  if (a == null or a == "") {
    return "";
  }
  let parts = split(a, " ");
  let n = len(parts);
  // 反代 Basic Auth 会塞 `Basic <base64>`,那不是 PIN,显式跳过。
  if (lower(parts[0]) == "basic") {
    return "";
  }
  if (n > 1) {
    return parts[n - 1];
  }
  return parts[0];
}

func visit_gate(req) {
  if (visit_pin == null or visit_pin == "") {
    // 公网只读演示 fail closed:忘配 PIN 时不能把访客 IP 列表裸奔。
    // 本地可写开发仍保留免 PIN 的便利。
    if (crm_readonly) {
      return { status: 403, body: { err: "访客统计 PIN 未配置" } };
    }
    return null;
  }
  let from_hdr = auth_pin(req);
  let from_query = get(req.query_params, "pin", "");
  if (from_hdr == visit_pin or from_query == visit_pin) {
    return null;
  }
  return { status: 403, body: { err: "forbidden" } };
}

// 领域层:SQLite 助手 + crm_* 聊天工具(import 时建库/灌种子,tool 顶层注册)
import "src/db.lume" as crmdb;

// SSR 组件库:客户分享页(纯函数组件,客户字段走 html() 标量槽自动转义)
import "src/share.lume" as crmshare;

// body 解析糖:返回固定两键 { ok, err }(和 try 一样),路由侧 b.ok / b.err
// 成员访问安全。ok 是解析出的 body map(失败为 null),err 是错误消息(成功 null)。
func body_of(req) {
  if (req.body == null) {
    return { ok: null, err: "缺少 body" };
  }
  let r = try(() => json(req.body));
  if (r.err != null) {
    return { ok: null, err: "body 不是合法 JSON: " + r.err };
  }
  return { ok: r.ok, err: null };
}

// 助手结果 → HTTP 响应。助手返回的是稀疏 map(成功只有 ok、失败只有 err),
// 成员访问在 Lume 里是严格的(缺键 500),跨稀疏 map 一律 get() 宽容读;
// 只有 try() 的固定 {ok,err} map 才能用 r.err/r.ok 成员访问。
func resp(res, created) {
  let err = get(res, "err", null);
  if (err != null) {
    return { status: int(res, "status", 500), body: { err: err } };
  }
  if (created) {
    return { status: 201, body: res };
  }
  return res;
}

// ------------------------------------------------ 读路径(sql_query 物理只读,免锁)
// 读接口返回 PII(客户档案/访客 IP),显式 no-store,避免浏览器或中间缓存
// 把数据留在磁盘上。lume 的 headers 只在带 body 的 envelope 路径生效,
// 所以用 helper 包一层,而不是直接返回裸 map。
func no_store(body) {
  return { headers: { "Cache-Control": "no-store" }, body: body };
}

get "/api/stats", (req) => {
  return no_store(crmdb.stats_payload());
};

// 访客统计:owner-only(GET /api/visits 走 visit_gate 校验)。
get "/api/visits", (req) => {
  let gate = visit_gate(req);
  if (gate != null) { return gate; }
  return no_store(crmdb.visits_summary());
};

// 访客埋点:记录一次页面访问(不 gate——只读演示也要统计访问量)。
// IP 只信 nginx 覆写的 X-Real-IP,回退连接端 remote_addr。不要读
// X-Forwarded-For:客户端可伪造/拼接多值,会把假 IP 写进库。仅 owner 经
// PIN 门禁可见;去重靠前端 localStorage 的 visitor id。
// referrer 只留 origin+path,剥掉 query/hash,避免把第三方 URL 里的
// token/搜索词等 PII 一起入库。
post "/api/visit", (req) => {
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  let path = get(b.ok, "path", "");
  let referrer = get(b.ok, "referrer", "");
  if (referrer != null and referrer != "") {
    referrer = split(referrer, "?")[0];
    referrer = split(referrer, "#")[0];
  }
  let ua = get(b.ok, "ua", "");
  let visitor = get(b.ok, "visitor", "");
  let ip = header_ci(req, "x-real-ip");
  if (ip == "" or ip == null) {
    ip = get(req, "remote_addr", "");
  }
  // 忽略列表(env LUME_CRM_IGNORE_IPS,逗号分隔公网 IP,如自己的代理出口):
  // 命中则不写入统计。值仅来自服务端配置;拼判断前清洗空格与单引号。
  if (ip != "" and ip != null) {
    let ignore = env("LUME_CRM_IGNORE_IPS");
    if (ignore != null and ignore != "") {
      ignore = replace(replace(ignore, " ", ""), "'", "");
      let needle = "," + ip + ",";
      if (replace("," + ignore + ",", needle, "") != "," + ignore + ",") {
        return { ok: true };
      }
    }
  }
  // 爬虫 UA 不入库(常见搜索引擎/AI 爬虫)。DSL 暂无 lower/contains,
  // 用 replace 做字面量包含判断,故大小写各列一个变体;查询层另有
  // SQLite LIKE 兜底过滤历史数据(LIKE 对 ASCII 不区分大小写)。
  let bots = [
    "Googlebot", "googlebot", "GoogleOther", "googleother",
    "Baiduspider", "baiduspider", "Bingbot", "bingbot",
    "YandexBot", "yandexbot", "DuckDuckBot", "duckduckbot",
    "PetalBot", "petalbot", "Bytespider", "bytespider",
    "SemrushBot", "semrushbot", "AhrefsBot", "ahrefsbot",
    "MJ12bot", "mj12bot", "Sogou", "sogou", "360Spider", "360spider",
    "ia_archiver", "archive.org_bot", "GPTBot", "gptbot",
    "ChatGPT-User", "chatgpt-user", "CCBot", "ccbot",
    "Applebot", "applebot", "ClaudeBot", "claudebot",
    "facebookexternalhit", "Twitterbot", "twitterbot",
    "LinkedInBot", "linkedinbot", "Pinterest", "pinterest",
    "TelegramBot", "telegrambot", "WhatsApp", "whatsapp"
  ];
  if (ua != "" and ua != null) {
    for (b in bots) {
      if (replace(ua, b, "") != ua) {
        return { ok: true };
      }
    }
  }
  crmdb.record_visit(path, referrer, ua, visitor, ip);
  return { ok: true };
};

get "/api/customers", (req) => {
  let q = get(req.query_params, "q", "");
  let sort = get(req.query_params, "sort", "");
  let list = crmdb.customer_list(q, sort);
  return no_store({ count: len(list), customers: list });
};

get "/api/customer", (req) => {
  let id = int(req.query_params, "id", 0);
  let c = crmdb.customer_by_id(id);
  if (c == null) {
    return { status: 404, body: { err: "客户 " + str(id) + " 不存在" } };
  }
  // 前端据此拼分享链接(/share/customer?id=N&token=...)。此接口在公网必须
  // 位于 Basic Auth 之后(见 deploy/nginx-lume-crm.conf),否则连同 PII 一起裸奔。
  // 首次访问会自动建一条 version=0 的兼容链接;撤销/过期后返回空 token,
  // 需要显式 POST /api/share/create 才重新生成(不会无限复活)。
  let link = crmdb.active_share_link(id);
  let token = "";
  let expires = 0;
  if (link != null) {
    token = get(link, "token", "");
    expires = int(get(link, "expires", 0));
  }
  put(c, "share_token", token);
  put(c, "share_expires", expires);
  return no_store(c);
};

// ------------------------------------------------ 写路径(助手里 flock 串行)
post "/api/customers", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.add_customer(
    str(b.ok, "name", ""),
    str(b.ok, "company", ""),
    str(b.ok, "email", ""),
    str(b.ok, "phone", "")), true);
};

post "/api/deals", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.add_deal(
    int(b.ok, "customer_id", 0),
    str(b.ok, "title", ""),
    str(b.ok, "stage", ""),
    float(b.ok, "amount", 0.0)), true);
};

// 推进管道:改某条商机的阶段/金额/标题(空串/零值 = 不改该字段)
post "/api/deals/update", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.update_deal(
    int(b.ok, "deal_id", 0),
    str(b.ok, "stage", ""),
    str(b.ok, "title", ""),
    float(b.ok, "amount", 0.0)), false);
};

post "/api/activities", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.add_activity(
    int(b.ok, "customer_id", 0),
    str(b.ok, "kind", ""),
    str(b.ok, "note", "")), true);
};

// 改客户资料(空串/空值 = 不改该字段;name 非空才覆盖)
post "/api/customers/update", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.update_customer(
    int(b.ok, "customer_id", 0),
    str(b.ok, "name", ""),
    str(b.ok, "company", ""),
    str(b.ok, "email", ""),
    str(b.ok, "phone", "")), false);
};

// 删除客户(级联清掉其名下商机/跟进)
post "/api/customers/delete", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.delete_customer(int(b.ok, "customer_id", 0)), false);
};

// 删一条商机
post "/api/deals/delete", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.delete_deal(int(b.ok, "deal_id", 0)), false);
};

// 删一条跟进
post "/api/activities/delete", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.delete_activity(int(b.ok, "activity_id", 0)), false);
};

// ------------------------------------------------ 分享链接管理(写,但仅安全控制)
// 刻意不套 write_gate:只读演示里也应允许撤销泄露链接;这些路由只写
// share_links,不改客户/商机数据。公网必须由 nginx Basic Auth 保护。
post "/api/share/create", (req) => {
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  let cid = int(b.ok, "customer_id", 0);
  if (crmdb.customer_by_id(cid) == null) {
    return { status: 404, body: { err: "客户不存在" } };
  }
  // 重新生成 = 轮换:旧链接立即失效,新链接用 version+1 的派生 token。
  if (not crmdb.revoke_share_links(cid)) {
    return { status: 500, body: { err: "旧分享链接撤销失败" } };
  }
  let link = crmdb.create_share_link(cid);
  if (link == null) {
    return { status: 500, body: { err: "分享链接生成失败(检查 SHARE_SALT 是否配置)" } };
  }
  return {
    headers: { "Cache-Control": "no-store" },
    body: {
      ok: true,
      customer_id: cid,
      share_token: get(link, "token", ""),
      share_expires: int(get(link, "expires", 0))
    }
  };
};

post "/api/share/revoke", (req) => {
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  let cid = int(b.ok, "customer_id", 0);
  if (crmdb.customer_by_id(cid) == null) {
    return { status: 404, body: { err: "客户不存在" } };
  }
  if (not crmdb.revoke_share_links(cid)) {
    return { status: 500, body: { err: "撤销失败" } };
  }
  return {
    headers: { "Cache-Control": "no-store" },
    body: { ok: true, customer_id: cid }
  };
};

// ------------------------------------------------ SSR:对外分享(只读,GET-only)
// 客户分享页:纯服务端渲染(el/html 组件,零 JS),可直接外发链接。
// 防枚举:必须带 `?token=` 且与 share_links 中未撤销、未过期的 token 精确匹配。
// 不区分"客户不存在 / token 不对 / 已撤销 / 已过期 / 未配置 salt",一律 404
// ——不给枚举者存在性 oracle。数据走已有的只读助手 customer_by_id。
get "/share/customer", (req) => {
  let id = int(req.query_params, "id", 0);
  let token = get(req.query_params, "token", "");
  let link = crmdb.share_link_by_token(id, token);
  if (link == null) {
    return { status: 404, body: { err: "not found" } };
  }
  let c = crmdb.customer_by_id(id);
  if (c == null) {
    return { status: 404, body: { err: "not found" } };
  }
  return {
    headers: {
      "Cache-Control": "no-store",
      "X-Robots-Tag": "noindex, nofollow, noarchive"
    },
    body: crmshare.share_page(c, crm_share_internal)
  };
};

// 发现页:框架内省目录(与 examples/demo.lume 同款口径)。tools() 反映真实
// 注册表——只读模式下只有 2 个查询工具,安全故事在页面上自证。
get "/discovery", (req) => {
  return {
    app: "lume-crm",
    readonly: crm_readonly,
    tools: tools(),
    skills: skills(),
    mcps: mcps(),
  };
};

// 业务字典(阶段白名单/跟进类型):前端选项的单一事实源
get "/api/meta", (req) => {
  return crmdb.meta_payload();
};

run();   // 注册窗口关闭,开始伺服
