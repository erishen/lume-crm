// crm.lume — CRM 入口:server{} + HTTP 路由 + 领域助手/工具 import
//
// 启动: lume crm.lume  → http://127.0.0.1:8089   (lume = release, 默认 ~/.local/bin/lume)
//   /            仪表盘(React SPA)   /customers  客户列表
//   /customers/N 客户详情            /chat       Agent 聊天(SSE)
//   GET  /api/customers?q=          客户列表(可选 ?q= 模糊筛选)
//   GET  /api/customer?id=<n>      客户全档
//   GET  /api/stats                 仪表盘统计
//   GET  /api/visits                访客统计(总 PV/今日/独立访客/近 14 天)
//   POST /api/visit                 访客埋点(前端加载时上报,不受只读限制)
//   POST /api/customers             新建客户
//   POST /api/deals                 新建商机
//   POST /api/deals/update          改商机阶段/金额/标题(空字段=不改)
//   POST /api/activities           新增跟进
//   GET  /share/customer?id=<n>    客户分享页(SSR 纯服务端渲染,零 JS,可外发)
//   GET  /discovery                框架内省:tools/skills/mcps 目录(JSON)
//   POST /react/api/chat           Agent SSE(框架原生,聊天页用)
//
// 数据层:SQLite(.data/crm.db)。路由只管 body 解析 + 调助手;
// 校验/锁/SQL 全在 src/db.lume 的助手里,与 agent 工具同源。
//
// 部署/安全:bind 默认 127.0.0.1(本地安全);容器化传 LUME_BIND=0.0.0.0 才能
// 被端口映射命中。htpasswd 走 env("HTPASSWD_FILE"):本地留空=无认证;公网
// 部署务必注入(见 docker-entrypoint.sh + compose),否则 /api/* 与聊天工具
// 裸暴露,任何人都可读写 .data/crm.db。

// bind 可经 env 覆盖(容器传 LUME_BIND=0.0.0.0);本地默认仍绑 127.0.0.1。
// htpasswd 走 env:本地留空=无认证,公网注入 HTPASSWD_FILE 即开 Basic Auth。
let crm_bind = env("LUME_BIND");
if (crm_bind == null) { crm_bind = "127.0.0.1"; }
server {
  port = 8089;
  workers = 2;
  bind = crm_bind;
  docroot = "./www";
  spa = true;        // SPA history 路由:GET + Accept:text/html + 静态 404
                     // → 回退 docroot/index.html;API 404 / fetch 保持原样
  htpasswd = env("HTPASSWD_FILE");
};

// 只读演示开关:LUME_CRM_READONLY=1 时全部写路由 403(公网演示无鉴权也玩不坏;
// 本地/开发不设该变量 = 完全可写)。Agent 工具面在 src/db.lume 同步收敛。
let crm_readonly = env("LUME_CRM_READONLY") == "1";

func write_gate() {
  if (crm_readonly) {
    return { status: 403, body: { err: "演示模式为只读(LUME_CRM_READONLY=1),写操作已禁用" } };
  }
  return null;
}

// 领域层:SQLite 助手 + crm_* 聊天工具(import 时建库/灌种子,tool 顶层注册)
import "src/db.lume" as crmdb;

// SSR 组件库:客户分享页(纯函数组件,客户字段走 html() 标量槽自动转义)
import "src/share.lume" as crmshare;

// body 解析糖:返回固定两键 { ok, err }(和 try 一样),路由侧 b.ok / b.err
// 成员访问安全。ok 是解析出的 body map(失败为 null),err 是错误消息(成功 null)。
func body_of(req) {
  if (req.body == null) {
    return { ok: null, err: "缺少 body" };
  }
  let r = try(() => json(req.body));
  if (r.err != null) {
    return { ok: null, err: "body 不是合法 JSON: " + r.err };
  }
  return { ok: r.ok, err: null };
}

// 助手结果 → HTTP 响应。助手返回的是稀疏 map(成功只有 ok、失败只有 err),
// 成员访问在 Lume 里是严格的(缺键 500),跨稀疏 map 一律 get() 宽容读;
// 只有 try() 的固定 {ok,err} map 才能用 r.err/r.ok 成员访问。
func resp(res, created) {
  let err = get(res, "err", null);
  if (err != null) {
    return { status: int(res, "status", 500), body: { err: err } };
  }
  if (created) {
    return { status: 201, body: res };
  }
  return res;
}

// ------------------------------------------------ 读路径(sql_query 物理只读,免锁)
get "/api/stats", (req) => {
  return crmdb.stats_payload();
};

get "/api/visits", (req) => {
  return crmdb.visits_summary();
};

// 访客埋点:记录一次页面访问(不 gate——只读演示也要统计访问量;无 IP,
// 去重靠前端 localStorage 的 visitor id,隐私干净)。
post "/api/visit", (req) => {
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  let path = get(b.ok, "path", "");
  let referrer = get(b.ok, "referrer", "");
  let ua = get(b.ok, "ua", "");
  let visitor = get(b.ok, "visitor", "");
  crmdb.record_visit(path, referrer, ua, visitor);
  return { ok: true };
};

get "/api/customers", (req) => {
  let q = get(req.query_params, "q", "");
  let sort = get(req.query_params, "sort", "");
  let list = crmdb.customer_list(q, sort);
  return { count: len(list), customers: list };
};

get "/api/customer", (req) => {
  let id = int(req.query_params, "id", 0);
  let c = crmdb.customer_by_id(id);
  if (c == null) {
    return { status: 404, body: { err: "客户 " + str(id) + " 不存在" } };
  }
  return c;
};

// ------------------------------------------------ 写路径(助手里 flock 串行)
post "/api/customers", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.add_customer(
    str(b.ok, "name", ""),
    str(b.ok, "company", ""),
    str(b.ok, "email", ""),
    str(b.ok, "phone", "")), true);
};

post "/api/deals", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.add_deal(
    int(b.ok, "customer_id", 0),
    str(b.ok, "title", ""),
    str(b.ok, "stage", ""),
    float(b.ok, "amount", 0.0)), true);
};

// 推进管道:改某条商机的阶段/金额/标题(空串/零值 = 不改该字段)
post "/api/deals/update", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.update_deal(
    int(b.ok, "deal_id", 0),
    str(b.ok, "stage", ""),
    str(b.ok, "title", ""),
    float(b.ok, "amount", 0.0)), false);
};

post "/api/activities", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.add_activity(
    int(b.ok, "customer_id", 0),
    str(b.ok, "kind", ""),
    str(b.ok, "note", "")), true);
};

// 改客户资料(空串/空值 = 不改该字段;name 非空才覆盖)
post "/api/customers/update", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.update_customer(
    int(b.ok, "customer_id", 0),
    str(b.ok, "name", ""),
    str(b.ok, "company", ""),
    str(b.ok, "email", ""),
    str(b.ok, "phone", "")), false);
};

// 删除客户(级联清掉其名下商机/跟进)
post "/api/customers/delete", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.delete_customer(int(b.ok, "customer_id", 0)), false);
};

// 删一条商机
post "/api/deals/delete", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.delete_deal(int(b.ok, "deal_id", 0)), false);
};

// 删一条跟进
post "/api/activities/delete", (req) => {
  let gate = write_gate();
  if (gate != null) { return gate; }
  let b = body_of(req);
  if (b.err != null) {
    return { status: 400, body: { err: b.err } };
  }
  return resp(crmdb.delete_activity(int(b.ok, "activity_id", 0)), false);
};

// ------------------------------------------------ SSR:对外分享(只读,GET-only)
// 客户分享页:纯服务端渲染(el/html 组件,零 JS),可直接外发链接。
// 数据走已有的只读助手 customer_by_id;404 与 API 同款语义。
get "/share/customer", (req) => {
  let id = int(req.query_params, "id", 0);
  let c = crmdb.customer_by_id(id);
  if (c == null) {
    return { status: 404, body: { err: "客户 " + str(id) + " 不存在" } };
  }
  return crmshare.share_page(c);
};

// 发现页:框架内省目录(与 examples/demo.lume 同款口径)。tools() 反映真实
// 注册表——只读模式下只有 2 个查询工具,安全故事在页面上自证。
get "/discovery", (req) => {
  return {
    app: "lume-crm",
    readonly: crm_readonly,
    tools: tools(),
    skills: skills(),
    mcps: mcps(),
  };
};

// 业务字典(阶段白名单/跟进类型):前端选项的单一事实源
get "/api/meta", (req) => {
  return crmdb.meta_payload();
};

run();   // 注册窗口关闭,开始伺服
