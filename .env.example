# 宿主映射端口: VPS 反代用 8089(默认);本地 8089 被占用时改 11080。
HOST_PORT=8089
HOST_BIND=127.0.0.1

# LLM 接入(OpenAI 兼容)。URL/key 任一留空 = 离线演示引擎(聊天页可走,但工具不真跑)。
# URL 示例(指向你自己的网关/供应商, 容器内用 host.docker.internal 访问宿主服务):
#   LLM_API_URL=http://host.docker.internal:<port>/v1/chat/completions
# 容器部署: 宿主机网关写 LLM_API_URL_DOCKER, 容器内解析 host.docker.internal;
#   原生 `make dev` 仍用 LLM_API_URL(localhost), 两者可并存。
#   LLM_API_URL_DOCKER=http://host.docker.internal:<port>/v1/chat/completions
LLM_API_URL=
LLM_MODEL=auto
LLM_API_KEY=
LLM_TIMEOUT=60

# 只读演示模式: 1 = 全部写 API 403 + Agent 只注册查询工具(公网无鉴权演示用)。
# 不设或 0 = 完全可写(本地/开发)。
LUME_CRM_READONLY=0

# 访客统计 PIN(>=32 hex;建议 `openssl rand -hex 32`)。配置后 /api/visits 需
# `X-CRM-Pin: <pin>`(推荐)或 Bearer/`?pin=`;公网务必设置。
# 只读演示(LUME_CRM_READONLY=1)不设则 /api/visits 一律 403。
LUME_CRM_VISIT_PIN=

# 分享页 salt(>=16 字符;建议 `openssl rand -hex 32`)。token 由 salt + 客户 id
# + 链接版本派生；salt 泄露才能伪造。未配置时回退用 LUME_CRM_VISIT_PIN 派生;
# 两者都没有则分享页一律 404。变量名不能含 SECRET/TOKEN/KEY —— lume 的
# env() 会把这类名字按未设置屏蔽。
LUME_CRM_SHARE_SALT=

# 分享链接 TTL(天): 默认 30;0 = 不过期(不推荐)。重新生成/撤销会让旧链接
# 立即失效；分享页默认隐藏内部跟进 note。
LUME_CRM_SHARE_TTL_DAYS=30
# 仅内部演示/自用时设 1,才会在分享页显示 activities.note。
LUME_CRM_SHARE_INCLUDE_INTERNAL=0

# 访客明细保留期(天): 默认 90;0 = 不自动清理(不推荐)。
LUME_CRM_VISIT_RETENTION_DAYS=90

# ---- peer 节点(供其它 lume 应用发现与查询)----
#
# 起法: make peer-up       (后台常驻, 日志 .runtime-peer.log)
#       make peer-serve    (前台, 调试时看日志)
#       make peer-status   (是否在听)
#
# ⚠️ peer 默认**开启**(见文件末尾 COMPOSE_PROFILES), 所以这个密钥是必填:
# 留空会让 docker compose 在启动前直接报错, 而不是给你一个"健康检查通过
# 但功能禁用"的容器 —— 后者更难排查。
#
# 不想开 peer: 注释掉末尾那行 COMPOSE_PROFILES=peer, 本段其余配置也不用填。
#
# 密钥必须与**访问方**(如 lume-lan)完全一致: 对端按 PEER_NAME 派生密钥
# 验签, 根密钥不同会全部 401。
# 生成一次, 所有节点共用: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
# 单机/局域网内自己用: 用这个默认值, 并与看板(lume-lan)的 PEER_SHARED 一致。
# 要接别的机器: 换成一个自己生成的随机串, 所有节点改成同一个。
#   生成: LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32
PEER_SHARED=lume-peer-dev-key
# 本节点名(必须出现在各节点的 .data/peers-identity.json 里, 否则被拒)
PEER_NAME=crm
# 身份层根密钥(与 PEER_SHARED 二选一即可; 配了它就用按节点派生的独立密钥)
PEER_ROOT=
# 监听地址。默认 127.0.0.1 = 只有本机能连(单机安全基线)。
# 跨机互访必须改成 0.0.0.0, 否则对方拿到的是"连接被拒", 看起来像网络问题。
# Makefile 的 peer-up 从这个变量取值, 所以改这里就生效, 不用改 Makefile。
PEER_BIND=127.0.0.1
# 端口由 Makefile 的 PEER_PORT_RUN 固定为 18102(CRM 的客户/商机聚合统计(只读))

# ---- 是否随 docker compose up 一起起 peer 节点 ----
# **默认开启**: 这行存在就起(容器名 lume-crm-peer, 只在共享网 lume-peer-net 内可见)。
# 不想开就注释掉 —— 只起主服务。
#
# 开启时 PEER_SHARED 是必填的: 缺了 compose 会在启动前报错, 而不是让你得到
# 一个"健康检查通过但功能禁用"的容器。
#
# 这是 compose 的原生开关: docker 会读 .env 里的 COMPOSE_PROFILES 并自动
# 启用同名 profile —— 所以不需要写 `--profile peer`。
COMPOSE_PROFILES=peer