# LLM 接入(OpenAI 兼容)。URL/key 任一留空 = 离线演示引擎(聊天页可走,但工具不真跑)。
# URL 示例(指向你自己的网关/供应商, 容器内用 host.docker.internal 访问宿主服务):
#   LLM_API_URL=http://host.docker.internal:<port>/v1/chat/completions
LLM_API_URL=
LLM_MODEL=auto
LLM_API_KEY=
LLM_TIMEOUT=60

# 只读演示模式: 1 = 全部写 API 403 + Agent 只注册查询工具(公网无鉴权演示用)。
# 不设或 0 = 完全可写(本地/开发)。
LUME_CRM_READONLY=0
