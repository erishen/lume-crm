# 依赖(符号链接到 ../lume/frontend/node_modules)
node_modules/

# 数据 / 密钥
.data/
.env

# 运行日志
logs/
*.log

# 构建产物 www/app.js 入库跟踪:Dockerfile 是 COPY www/ 容器内不重编,
# 忽略它会让 fresh clone 的 docker build 出白屏镜像。改 src/crm/ 后必须
# `npm run build`(或 esbuild 重打包)并把产物一并提交。
# 手写的 www/app.css 与 www/index.html 是源码,本就跟踪。

# bin/(本仓不自建二进制,用 ../lume/bin/lume)
bin/
!bin/.gitkeep

# ---- 运行时产物 (make peer-up / agent 启动时生成) ----
# 不加这些规则时, 每跑一次 peer 就有一批未跟踪文件进 git status;
# 一次 `git add .` 就会把本机 pid、日志、临时脚本带进公开仓。
# .runtime/ 里还有 MCP 同步产物和会话数据, 体积也可能很大。
.runtime/
.runtime-*.pid
*_tmp.lume
*_tmp.py
